# --- Database ---
DATABASE_URL=postgresql+asyncpg://lornux:lornux@localhost:5432/lornux
DATABASE_URL_SYNC=postgresql+psycopg2://lornux:lornux@localhost:5432/lornux

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=       # chat_id عددی ادمین (برای ارسال پیش‌نمایش پست‌ها)
TELEGRAM_CHANNEL_ID=          # مثلاً @lornux یا chat_id عددی کانال مقصد

# --- LLM Providers (هر دو رایگان - free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Rate limiting (باید با محدودیت واقعی free tier هماهنگ باشد - در AI Studio چک کنید) ---
GEMINI_RPM_LIMIT=15
GEMINI_RPD_LIMIT=1500

# --- Pipeline tuning ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
DEDUP_SIMILARITY_THRESHOLD=0.92
RELATED_SIMILARITY_THRESHOLD=0.80
SCORE_WORTH_POSTING_THRESHOLD=65
POLL_INTERVAL_MINUTES=20
DIGEST_HOUR_UTC=20

# --- Media Finder (فاز ۲) ---
MEDIA_ENABLED=true

# --- Telegram Channel Collection via MTProto (فاز ۲، اختیاری — ریسک واقعی دارد، پیش‌فرض خاموش) ---
# قبل از فعال کردن حتماً بخش «کانال‌های تلگرام» در README را بخوانید.
MTPROTO_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# --- Signature (به انتهای هر پست منتشرشده اضافه می‌شود، جدا از خروجی LLM) ---
CHANNEL_SIGNATURE=🚀 Lornux | Technology, AI & Future

# --- Admin API (فاز آخر) ---
# یک مقدار تصادفی قوی و منحصربه‌فرد اینجا بگذارید مثلاً با openssl rand -hex 32
ADMIN_API_KEY=
